<?xml version="1.0"?>
<ruleset name="Deimos Lost &amp; Found Animals">
	<description>Coding standards for Deimos Lost &amp; Found Animals.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<!-- Development-only code that is never shipped in the plugin ZIP. -->
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<config name="minimum_wp_version" value="5.0"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="deimos-lost-found-animals"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="deimlofo"/>
			</property>
		</properties>
	</rule>

	<!-- Established file layout; renaming the include files brings no functional benefit. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*</exclude-pattern>
	</rule>
	<!-- The main plugin file intentionally holds the plugin class and its helper functions. -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude-pattern>/deimos-lost-found-animals\.php$</exclude-pattern>
	</rule>

</ruleset>
